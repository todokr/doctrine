{
  "name": "@doctrine/core",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.8.1"
  },
  "scripts": {
    "check": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:update-snapshots": "node --test --test-update-snapshots \"test/guide/jsonSchema.test.ts\"",
    "build": "node scripts/build.ts",
    "install:bin": "node scripts/install.ts",
    "test:binary": "pnpm run build && DOCTRINE_TEST_BINARY=1 node --test test/integration/binary.test.ts"
  },
  "dependencies": {
    "kysely": "0.28.17",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26",
    "esbuild": "0.25.11",
    "typescript": "~6.0.3"
  }
}

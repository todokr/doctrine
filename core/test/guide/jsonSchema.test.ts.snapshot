exports[`生成した JSON Schema がスナップショットと一致する 1`] = `
"{\\n  \\"$schema\\": \\"http://json-schema.org/draft-07/schema#\\",\\n  \\"type\\": \\"object\\",\\n  \\"properties\\": {\\n    \\"version\\": {\\n      \\"description\\": \\"この形式の版\\",\\n      \\"type\\": \\"number\\",\\n      \\"const\\": 1\\n    },\\n    \\"why\\": {\\n      \\"description\\": \\"この変更の目的。GFM のうち、生の HTML・画像・見出しを除いた記法で書く。\\",\\n      \\"type\\": \\"string\\"\\n    },\\n    \\"what\\": {\\n      \\"description\\": \\"変更を概念の単位に分けたもの\\",\\n      \\"type\\": \\"array\\",\\n      \\"items\\": {\\n        \\"type\\": \\"object\\",\\n        \\"properties\\": {\\n          \\"name\\": {\\n            \\"description\\": \\"概念の名前\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"summary\\": {\\n            \\"description\\": \\"その概念について何が変わったか。GFM のうち、生の HTML・画像・見出しを除いた記法で書く。\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"paths\\": {\\n            \\"description\\": \\"この概念に属するファイルのパス。複数の概念に出てよい\\",\\n            \\"type\\": \\"array\\",\\n            \\"items\\": {\\n              \\"type\\": \\"string\\"\\n            }\\n          }\\n        },\\n        \\"required\\": [\\n          \\"name\\",\\n          \\"summary\\",\\n          \\"paths\\"\\n        ],\\n        \\"additionalProperties\\": false\\n      }\\n    },\\n    \\"how\\": {\\n      \\"description\\": \\"実現方法を説明文と図の並びで示したもの\\",\\n      \\"type\\": \\"array\\",\\n      \\"items\\": {\\n        \\"type\\": \\"object\\",\\n        \\"properties\\": {\\n          \\"body\\": {\\n            \\"description\\": \\"実現方法の説明。GFM のうち、生の HTML・画像・見出しを除いた記法で書く。\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"diagram\\": {\\n            \\"description\\": \\"この説明に添える diagrams の id\\",\\n            \\"type\\": \\"string\\"\\n          }\\n        },\\n        \\"required\\": [\\n          \\"body\\"\\n        ],\\n        \\"additionalProperties\\": false\\n      }\\n    },\\n    \\"readingOrder\\": {\\n      \\"description\\": \\"diff を読む順に並べたグループ\\",\\n      \\"type\\": \\"array\\",\\n      \\"items\\": {\\n        \\"type\\": \\"object\\",\\n        \\"properties\\": {\\n          \\"title\\": {\\n            \\"description\\": \\"グループのタイトル\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"body\\": {\\n            \\"description\\": \\"このグループで何を読み取るか。GFM のうち、生の HTML・画像・見出しを除いた記法で書く。\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"locations\\": {\\n            \\"description\\": \\"読む箇所を読む順に並べたもの\\",\\n            \\"type\\": \\"array\\",\\n            \\"items\\": {\\n              \\"type\\": \\"object\\",\\n              \\"properties\\": {\\n                \\"path\\": {\\n                  \\"description\\": \\"リポジトリのルートからのファイルパス\\",\\n                  \\"type\\": \\"string\\"\\n                },\\n                \\"hunk\\": {\\n                  \\"description\\": \\"doctrine が振った hunk の id。省くとファイル全体を指す\\",\\n                  \\"type\\": \\"string\\"\\n                }\\n              },\\n              \\"required\\": [\\n                \\"path\\"\\n              ],\\n              \\"additionalProperties\\": false\\n            }\\n          },\\n          \\"refs\\": {\\n            \\"type\\": \\"object\\",\\n            \\"properties\\": {\\n              \\"decisions\\": {\\n                \\"description\\": \\"関連する decisions の id。無ければ空配列\\",\\n                \\"type\\": \\"array\\",\\n                \\"items\\": {\\n                  \\"type\\": \\"string\\"\\n                }\\n              },\\n              \\"risks\\": {\\n                \\"description\\": \\"関連する risks の id。無ければ空配列\\",\\n                \\"type\\": \\"array\\",\\n                \\"items\\": {\\n                  \\"type\\": \\"string\\"\\n                }\\n              },\\n              \\"tests\\": {\\n                \\"description\\": \\"関連する tests の id。無ければ空配列\\",\\n                \\"type\\": \\"array\\",\\n                \\"items\\": {\\n                  \\"type\\": \\"string\\"\\n                }\\n              },\\n              \\"diagrams\\": {\\n                \\"description\\": \\"関連する diagrams の id。無ければ空配列\\",\\n                \\"type\\": \\"array\\",\\n                \\"items\\": {\\n                  \\"type\\": \\"string\\"\\n                }\\n              }\\n            },\\n            \\"required\\": [\\n              \\"decisions\\",\\n              \\"risks\\",\\n              \\"tests\\",\\n              \\"diagrams\\"\\n            ],\\n            \\"additionalProperties\\": false\\n          }\\n        },\\n        \\"required\\": [\\n          \\"title\\",\\n          \\"body\\",\\n          \\"locations\\",\\n          \\"refs\\"\\n        ],\\n        \\"additionalProperties\\": false\\n      }\\n    },\\n    \\"decisions\\": {\\n      \\"description\\": \\"設計上の判断\\",\\n      \\"type\\": \\"array\\",\\n      \\"items\\": {\\n        \\"type\\": \\"object\\",\\n        \\"properties\\": {\\n          \\"id\\": {\\n            \\"description\\": \\"decisions の中で一意な id\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"decision\\": {\\n            \\"description\\": \\"下した判断\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"reason\\": {\\n            \\"description\\": \\"その理由。GFM のうち、生の HTML・画像・見出しを除いた記法で書く。\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"source\\": {\\n            \\"description\\": \\"判断の出典\\",\\n            \\"type\\": \\"object\\",\\n            \\"properties\\": {\\n              \\"kind\\": {\\n                \\"description\\": \\"step: ワークフローのステップ id / file: worktree 内のファイルパス\\",\\n                \\"type\\": \\"string\\",\\n                \\"enum\\": [\\n                  \\"step\\",\\n                  \\"file\\"\\n                ]\\n              },\\n              \\"value\\": {\\n                \\"description\\": \\"kind に応じたステップ id かファイルパス\\",\\n                \\"type\\": \\"string\\"\\n              }\\n            },\\n            \\"required\\": [\\n              \\"kind\\",\\n              \\"value\\"\\n            ],\\n            \\"additionalProperties\\": false\\n          }\\n        },\\n        \\"required\\": [\\n          \\"id\\",\\n          \\"decision\\",\\n          \\"reason\\"\\n        ],\\n        \\"additionalProperties\\": false\\n      }\\n    },\\n    \\"risks\\": {\\n      \\"description\\": \\"リスク。事実を書き、読み手への指示は書かない\\",\\n      \\"type\\": \\"array\\",\\n      \\"items\\": {\\n        \\"type\\": \\"object\\",\\n        \\"properties\\": {\\n          \\"id\\": {\\n            \\"description\\": \\"risks の中で一意な id\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"kind\\": {\\n            \\"description\\": \\"breaks: 壊れるもの / assumption: 置いた前提 / unknown: 確かめられていないこと / considered: 検討して問題ないと判断したこと\\",\\n            \\"type\\": \\"string\\",\\n            \\"enum\\": [\\n              \\"breaks\\",\\n              \\"assumption\\",\\n              \\"unknown\\",\\n              \\"considered\\"\\n            ]\\n          },\\n          \\"impact\\": {\\n            \\"description\\": \\"この項目が悪い方に転んだとき（壊れた・前提が崩れた・分からないことが悪い側だった・問題ないという判断が外れた）に起きることの大きさ。high: データの消失・破損や権限・秘密の露出、またはコードを戻すだけでは元に戻らない / medium: 既存の動作が変わるか誤った結果を返すが、コードを戻せば元に戻る / low: 利用者から見える動作は変わらない\\",\\n            \\"type\\": \\"string\\",\\n            \\"enum\\": [\\n              \\"high\\",\\n              \\"medium\\",\\n              \\"low\\"\\n            ]\\n          },\\n          \\"body\\": {\\n            \\"description\\": \\"事実として書いた文章。悪い方に転んだとき何が起きるかを含め、impact の根拠が読めるようにする。推測や評価は混ぜない。GFM のうち、生の HTML・画像・見出しを除いた記法で書く。\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"locations\\": {\\n            \\"description\\": \\"関係する箇所。無ければ空配列\\",\\n            \\"type\\": \\"array\\",\\n            \\"items\\": {\\n              \\"type\\": \\"object\\",\\n              \\"properties\\": {\\n                \\"path\\": {\\n                  \\"description\\": \\"リポジトリのルートからのファイルパス\\",\\n                  \\"type\\": \\"string\\"\\n                },\\n                \\"hunk\\": {\\n                  \\"description\\": \\"doctrine が振った hunk の id。省くとファイル全体を指す\\",\\n                  \\"type\\": \\"string\\"\\n                }\\n              },\\n              \\"required\\": [\\n                \\"path\\"\\n              ],\\n              \\"additionalProperties\\": false\\n            }\\n          }\\n        },\\n        \\"required\\": [\\n          \\"id\\",\\n          \\"kind\\",\\n          \\"impact\\",\\n          \\"body\\",\\n          \\"locations\\"\\n        ],\\n        \\"additionalProperties\\": false\\n      }\\n    },\\n    \\"tests\\": {\\n      \\"description\\": \\"変更を確かめるテスト\\",\\n      \\"type\\": \\"array\\",\\n      \\"items\\": {\\n        \\"type\\": \\"object\\",\\n        \\"properties\\": {\\n          \\"id\\": {\\n            \\"description\\": \\"tests の中で一意な id\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"behavior\\": {\\n            \\"description\\": \\"そのテストが確かめる振る舞い\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"path\\": {\\n            \\"description\\": \\"テストのファイルパス\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"name\\": {\\n            \\"description\\": \\"テスト名\\",\\n            \\"type\\": \\"string\\"\\n          }\\n        },\\n        \\"required\\": [\\n          \\"id\\",\\n          \\"behavior\\",\\n          \\"path\\",\\n          \\"name\\"\\n        ],\\n        \\"additionalProperties\\": false\\n      }\\n    },\\n    \\"diagrams\\": {\\n      \\"description\\": \\"図。形はシーケンスとグラフの 2 つだけ\\",\\n      \\"type\\": \\"array\\",\\n      \\"items\\": {\\n        \\"type\\": \\"object\\",\\n        \\"properties\\": {\\n          \\"id\\": {\\n            \\"description\\": \\"diagrams の中で一意な id\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"title\\": {\\n            \\"description\\": \\"図のタイトル\\",\\n            \\"type\\": \\"string\\"\\n          },\\n          \\"body\\": {\\n            \\"anyOf\\": [\\n              {\\n                \\"type\\": \\"object\\",\\n                \\"properties\\": {\\n                  \\"shape\\": {\\n                    \\"type\\": \\"string\\",\\n                    \\"const\\": \\"sequence\\"\\n                  },\\n                  \\"actors\\": {\\n                    \\"description\\": \\"登場する主体を左から並べた名前\\",\\n                    \\"type\\": \\"array\\",\\n                    \\"items\\": {\\n                      \\"type\\": \\"string\\"\\n                    }\\n                  },\\n                  \\"messages\\": {\\n                    \\"description\\": \\"時系列順のやり取り\\",\\n                    \\"type\\": \\"array\\",\\n                    \\"items\\": {\\n                      \\"type\\": \\"object\\",\\n                      \\"properties\\": {\\n                        \\"from\\": {\\n                          \\"description\\": \\"送り手の actors 上の名前\\",\\n                          \\"type\\": \\"string\\"\\n                        },\\n                        \\"to\\": {\\n                          \\"description\\": \\"受け手の actors 上の名前\\",\\n                          \\"type\\": \\"string\\"\\n                        },\\n                        \\"label\\": {\\n                          \\"description\\": \\"やり取りの内容\\",\\n                          \\"type\\": \\"string\\"\\n                        },\\n                        \\"change\\": {\\n                          \\"description\\": \\"この要素がこの変更で加わった（added）・変わった（changed）・除かれた（removed）もの\\",\\n                          \\"type\\": \\"string\\",\\n                          \\"enum\\": [\\n                            \\"added\\",\\n                            \\"changed\\",\\n                            \\"removed\\"\\n                          ]\\n                        }\\n                      },\\n                      \\"required\\": [\\n                        \\"from\\",\\n                        \\"to\\",\\n                        \\"label\\"\\n                      ],\\n                      \\"additionalProperties\\": false\\n                    }\\n                  }\\n                },\\n                \\"required\\": [\\n                  \\"shape\\",\\n                  \\"actors\\",\\n                  \\"messages\\"\\n                ],\\n                \\"additionalProperties\\": false\\n              },\\n              {\\n                \\"type\\": \\"object\\",\\n                \\"properties\\": {\\n                  \\"shape\\": {\\n                    \\"type\\": \\"string\\",\\n                    \\"const\\": \\"graph\\"\\n                  },\\n                  \\"kind\\": {\\n                    \\"description\\": \\"relation: 関係 / dependency: 依存 / state: 状態遷移\\",\\n                    \\"type\\": \\"string\\",\\n                    \\"enum\\": [\\n                      \\"relation\\",\\n                      \\"dependency\\",\\n                      \\"state\\"\\n                    ]\\n                  },\\n                  \\"nodes\\": {\\n                    \\"type\\": \\"array\\",\\n                    \\"items\\": {\\n                      \\"type\\": \\"object\\",\\n                      \\"properties\\": {\\n                        \\"id\\": {\\n                          \\"description\\": \\"この図の中で一意なノードの id\\",\\n                          \\"type\\": \\"string\\"\\n                        },\\n                        \\"label\\": {\\n                          \\"description\\": \\"ノードの表示名\\",\\n                          \\"type\\": \\"string\\"\\n                        },\\n                        \\"change\\": {\\n                          \\"description\\": \\"この要素がこの変更で加わった（added）・変わった（changed）・除かれた（removed）もの\\",\\n                          \\"type\\": \\"string\\",\\n                          \\"enum\\": [\\n                            \\"added\\",\\n                            \\"changed\\",\\n                            \\"removed\\"\\n                          ]\\n                        }\\n                      },\\n                      \\"required\\": [\\n                        \\"id\\",\\n                        \\"label\\"\\n                      ],\\n                      \\"additionalProperties\\": false\\n                    }\\n                  },\\n                  \\"edges\\": {\\n                    \\"type\\": \\"array\\",\\n                    \\"items\\": {\\n                      \\"type\\": \\"object\\",\\n                      \\"properties\\": {\\n                        \\"from\\": {\\n                          \\"description\\": \\"始点のノードの id\\",\\n                          \\"type\\": \\"string\\"\\n                        },\\n                        \\"to\\": {\\n                          \\"description\\": \\"終点のノードの id\\",\\n                          \\"type\\": \\"string\\"\\n                        },\\n                        \\"label\\": {\\n                          \\"description\\": \\"辺の表示名。無ければ空文字\\",\\n                          \\"type\\": \\"string\\"\\n                        },\\n                        \\"change\\": {\\n                          \\"description\\": \\"この要素がこの変更で加わった（added）・変わった（changed）・除かれた（removed）もの\\",\\n                          \\"type\\": \\"string\\",\\n                          \\"enum\\": [\\n                            \\"added\\",\\n                            \\"changed\\",\\n                            \\"removed\\"\\n                          ]\\n                        }\\n                      },\\n                      \\"required\\": [\\n                        \\"from\\",\\n                        \\"to\\",\\n                        \\"label\\"\\n                      ],\\n                      \\"additionalProperties\\": false\\n                    }\\n                  }\\n                },\\n                \\"required\\": [\\n                  \\"shape\\",\\n                  \\"kind\\",\\n                  \\"nodes\\",\\n                  \\"edges\\"\\n                ],\\n                \\"additionalProperties\\": false\\n              }\\n            ]\\n          }\\n        },\\n        \\"required\\": [\\n          \\"id\\",\\n          \\"title\\",\\n          \\"body\\"\\n        ],\\n        \\"additionalProperties\\": false\\n      }\\n    }\\n  },\\n  \\"required\\": [\\n    \\"version\\",\\n    \\"why\\",\\n    \\"what\\",\\n    \\"how\\",\\n    \\"readingOrder\\",\\n    \\"decisions\\",\\n    \\"risks\\",\\n    \\"tests\\",\\n    \\"diagrams\\"\\n  ],\\n  \\"additionalProperties\\": false\\n}"
`;

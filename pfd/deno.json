{
  "fmt": {
    "include": ["src/", "test/"],
    "lineWidth": 100
  },
  "lint": {
    "include": ["src/", "test/"]
  },
  "tasks": {
    "test": "deno test --allow-all test/",
    "check": "deno check src test",
    "install": "deno install -g -A -f --config deno.json -n pfd src/cli.ts"
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "yaml": "npm:yaml@^2.6.0",
    "zod": "npm:zod@^3.24.0"
  }
}

---
// トップページの機能紹介の 1 行。文章と図を 2 列に並べ、偶数行は左右を入れ替える。
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="feature-row not-content">
  <div class="feature-text">
    <h3>{title}</h3>
    <p><slot /></p>
  </div>
  <div class="feature-visual">
    <slot name="visual" />
  </div>
</section>

<style>
  .feature-row {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    margin-block: 2.5rem;
  }
  .feature-text h3 {
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-2xl);
    font-weight: 700;
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .feature-text p {
    margin: 0;
    color: var(--sl-color-gray-2);
    line-height: 1.8;
  }
  @media (min-width: 50rem) {
    .feature-row {
      grid-template-columns: 5fr 6fr;
      gap: 3rem;
    }
    .feature-row:nth-of-type(even) .feature-text {
      order: 2;
    }
  }
</style>
